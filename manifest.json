{
  "manifest_version": 3,
  "name": "Importador Yoka - Liga Paulista",
  "version": "1.5.0",
  "description": "Assistente operacional do Yoka para cadastro, documentos, atletas, registros da Liga, transferências e configurações independentes da página atual.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.googleusercontent.com/*",
    "https://docs.google.com/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://ligapaulistafutsal.bigmidia.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png"
      ],
      "matches": [
        "https://ligapaulistafutsal.bigmidia.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ligapaulistafutsal.bigmidia.com/atleta/create*",
        "https://ligapaulistafutsal.bigmidia.com/atleta/update*"
      ],
      "js": [
        "content.js",
        "features-v148.js",
        "bulk-files-v148.js",
        "league-registry-v149.js",
        "register-unsynced-v149.js",
        "default-icon-v148.js",
        "mapping-catalog-v150.js",
        "app-shell-v150.js",
        "config-v150.js",
        "compact-layout-v149.js"
      ],
      "css": [
        "styles.css",
        "app-shell-v150.css",
        "compact-layout-v149.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ligapaulistafutsal.bigmidia.com/atleta/index*"
      ],
      "js": [
        "app-shell-v150.js",
        "config-v150.js",
        "league-registry-sync-v149.js",
        "compact-layout-v149.js"
      ],
      "css": [
        "styles.css",
        "app-shell-v150.css",
        "compact-layout-v149.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ligapaulistafutsal.bigmidia.com/bid/create*"
      ],
      "js": [
        "app-shell-v150.js",
        "config-v150.js",
        "transfer-v149.js",
        "compact-layout-v149.js"
      ],
      "css": [
        "styles.css",
        "app-shell-v150.css",
        "compact-layout-v149.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ligapaulistafutsal.bigmidia.com/*"
      ],
      "exclude_matches": [
        "https://ligapaulistafutsal.bigmidia.com/atleta/create*",
        "https://ligapaulistafutsal.bigmidia.com/atleta/update*",
        "https://ligapaulistafutsal.bigmidia.com/atleta/index*",
        "https://ligapaulistafutsal.bigmidia.com/bid/create*"
      ],
      "js": [
        "app-shell-v150.js",
        "config-v150.js",
        "compact-layout-v149.js"
      ],
      "css": [
        "styles.css",
        "app-shell-v150.css",
        "compact-layout-v149.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Importador Yoka",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background-v149.js"
  }
}
