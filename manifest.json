{
  "manifest_version": 3,
  "name": "Importador Yoka - Liga Paulista",
  "version": "1.0.0",
  "description": "Preenchimento assistido do cadastro de atletas da Liga Paulista a partir de CSV, com consulta à RFB e salvamento manual.",
  "permissions": ["storage"],
  "host_permissions": ["https://ligapaulistafutsal.bigmidia.com/*"],
  "content_scripts": [
    {
      "matches": ["https://ligapaulistafutsal.bigmidia.com/atleta/create*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Importador Yoka",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
